{
  "name": "@runsecure/hkdfguard-keywrapping-azurekeyvault",
  "version": "0.9.0",
  "description": "HkdfGuard KeyWrapper over an RSA wrapping key and an EC P-256 signing key in Azure Key Vault (Azure SDK for JavaScript), reading key files only from where no untrusted account could have replaced them.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test*"
  ],
  "scripts": {
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@azure/keyvault-keys": "4.10.2",
    "@runsecure/hkdfguard-abstractions": "0.9.0",
    "@runsecure/hkdfguard-securefile": "0.9.0"
  },
  "devDependencies": {
    "@azure/core-rest-pipeline": "1.25.0",
    "@azure/identity": "4.13.3",
    "@runsecure/hkdfguard-cryptoprovider-aesgcm256": "0.9.0",
    "@runsecure/hkdfguard-test-support": "0.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
