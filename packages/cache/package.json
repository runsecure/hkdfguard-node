{
  "name": "@runsecure/hkdfguard-cache",
  "version": "0.9.1",
  "description": "HkdfGuard protected caches: values encrypted under a key ring and bound to their names, with pull-through sources, collections and a cache over a trusted folder of one encrypted file per secret.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test*"
  ],
  "scripts": {
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@runsecure/hkdfguard-abstractions": "0.9.1",
    "@runsecure/hkdfguard-diagnostics": "0.9.1",
    "@runsecure/hkdfguard-securefile": "0.9.1"
  },
  "devDependencies": {
    "@runsecure/hkdfguard-dek": "0.9.1",
    "@runsecure/hkdfguard-test-support": "0.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
