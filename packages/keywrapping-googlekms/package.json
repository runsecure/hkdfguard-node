{
  "name": "@runsecure/hkdfguard-keywrapping-googlekms",
  "version": "0.9.0",
  "description": "HkdfGuard KeyWrapper over one symmetric Google Cloud KMS key (Google Cloud client library for Node.js), reading key files only from where no untrusted account could have replaced them.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test*"
  ],
  "scripts": {
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@google-cloud/kms": "6.3.0",
    "@runsecure/hkdfguard-abstractions": "0.9.0",
    "@runsecure/hkdfguard-securefile": "0.9.0"
  },
  "devDependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@runsecure/hkdfguard-cryptoprovider-aesgcm256": "0.9.0",
    "@runsecure/hkdfguard-test-support": "0.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
