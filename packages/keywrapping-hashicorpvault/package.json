{
  "name": "@runsecure/hkdfguard-keywrapping-hashicorpvault",
  "version": "0.9.0",
  "description": "HkdfGuard KeyWrapper over one key in a HashiCorp Vault transit secrets engine (Node's own HTTPS client, no third-party dependency), reading key files only from where no untrusted account could have replaced them.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test*"
  ],
  "scripts": {
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@runsecure/hkdfguard-abstractions": "0.9.0",
    "@runsecure/hkdfguard-securefile": "0.9.0"
  },
  "devDependencies": {
    "@runsecure/hkdfguard-cryptoprovider-aesgcm256": "0.9.0",
    "@runsecure/hkdfguard-test-support": "0.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
