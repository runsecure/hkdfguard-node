{
  "name": "@runsecure/hkdfguard-cache-hashicorpvault",
  "version": "0.9.1",
  "description": "HkdfGuard protected read-only cache over HashiCorp Vault's KV secrets engine (Node's own HTTPS client): each secret is read on its first lookup, parsed straight from the response stream, encrypted under the key ring's current key and cached only as ciphertext.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test*"
  ],
  "scripts": {
    "test": "node --test --test-timeout=120000 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@runsecure/hkdfguard-abstractions": "0.9.1",
    "@runsecure/hkdfguard-cache": "0.9.1",
    "@runsecure/hkdfguard-diagnostics": "0.9.1",
    "@runsecure/hkdfguard-integration-hashicorpvault": "0.9.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@runsecure/hkdfguard-dek": "0.9.1",
    "@runsecure/hkdfguard-test-support": "0.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
