{
  "name": "@runsecure/hkdfguard-keywrapping-native-v1",
  "version": "0.9.1",
  "description": "HkdfGuard KeyWrapper over the operating system's native HkdfGuard KMS library (TPM2, Secure Enclave, Platform Crypto Provider), loaded only after verification.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "gypfile": true,
  "files": [
    "dist",
    "!dist/**/*.test*",
    "native",
    "binding.gyp",
    "scripts"
  ],
  "scripts": {
    "install": "node scripts/build-addon.js",
    "test": "node --test --test-timeout=120000 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@runsecure/hkdfguard-abstractions": "0.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@runsecure/hkdfguard-test-support": "0.0.0"
  }
}
